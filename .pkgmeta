# The repository root IS the addon folder - ARPGHealth.toc sits beside
# this file rather than inside an ARPGHealth/ subfolder. package-as tells
# the packager to wrap everything in that folder name inside the zip. Without
# it the archive would unpack loose files straight into AddOns/ and WoW would
# not see an addon at all.
package-as: ARPGHealth

# Ship the curated changelog rather than one assembled from commit messages,
# which leaned on internal detail that means nothing to a player.
manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

# No embedded libraries, so there is no meaningful "no libraries" variant to
# build alongside the normal package.
enable-nolib-creation: no

# Repository plumbing that should not ship to players.
ignore:
    - .github
    - .pkgmeta
